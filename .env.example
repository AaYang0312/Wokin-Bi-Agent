# API配置。开发时前端默认运行于 http://127.0.0.1:5175。
APP_ENV=development
APP_ALLOWED_SUBJECTS=
APP_PUBLIC_ORIGIN=http://127.0.0.1:5175
AUTH_SUBJECT_HEADER=X-Auth-Request-Sub
BI_SHOP_IDS=
# API使用bi_app身份：可读报表视图，并只能读写自己的聊天会话。
BI_APP_DSN=

# 语义目录启动预检：只允许 true/false。开启后启动时先用 BI_APP_DSN 做一次只读
# introspection，核对语义目录声明与 reporting 视图一致；不一致则启动失败。默认关闭。
SEMANTIC_CATALOG_ENABLED=false

# 受控 SQL 探索：只允许 true/false，且必须在 SEMANTIC_CATALOG_ENABLED=true 时才能开
# （探索层只复用语义目录的稳定 ref 解析标识符；目录关着时配置加载直接报
# CONTROLLED_SQL_REQUIRES_SEMANTIC_CATALOG）。默认关闭；关闭时工具列表、数据库读与
# 聊天结果与没有这个功能的版本完全一致。
CONTROLLED_SQL_ENABLED=false

# approved 查询学习记忆：只允许 true/false。默认关闭；关闭时检索、写路径与审核入口
# 都不存在，Tool 列表、数据库读与聊天结果与没有这个功能的版本完全一致。开启时
# APP_APPROVER_SUBJECTS 必须非空、BI_APPROVER_DSN 必须存在且不等于 BI_APP_DSN：
# 能写长期记忆的只有独立审核身份，聊天身份 bi_app 只读 approved 投影视图。
APPROVED_QUERY_MEMORY_ENABLED=false
APP_APPROVER_SUBJECTS=
BI_APPROVER_DSN=

# 隔离分析（分析已持久化的 Artifact）：只允许 true/false。默认关闭；关闭时不注册
# analyze_artifact 工具、不读取 Artifact，聊天结果与没有这个功能的版本完全一致。
ISOLATED_ANALYSIS_ENABLED=false

# 模型配置：只填写所选provider对应的一项密钥。
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
QWEN_API_KEY=
DEEPSEEK_API_KEY=

# 同步配置。仅放入独立的.env.sync，不能出现在API环境。
BI_WRITER_DSN=
KUAI_MAI_APP_KEY=
KUAI_MAI_APP_SECRET=
KUAI_MAI_APP_TITLE=
KUAI_MAI_COMPANY_ID=
KUAI_MAI_ACCESS_TOKEN=
KUAI_MAI_REFRESH_TOKEN=
